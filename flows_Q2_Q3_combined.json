    {
        "id": "fn_decision",
        "type": "function",
        "z": "tab_b",
        "name": "Check Temperature & Door",
        "func": "let data = msg.payload;\n\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        node.error(\"Invalid JSON sensor data\", msg);\n        return null;\n    }\n}\n\nlet temp = Number(data.temp);\nlet doorOpen = data.door_open === true;\n\nif (Number.isNaN(temp)) {\n    node.error(\"Temperature is missing or invalid\", msg);\n    return null;\n}\n\n// track how long the door has been open using node context\nlet doorSince = context.get(\"doorSince\") || 0;\n\nif (doorOpen && doorSince === 0) {\n    doorSince = Date.now();\n    context.set(\"doorSince\", doorSince);\n}\n\nif (!doorOpen) {\n    doorSince = 0;\n    context.set(\"doorSince\", 0);\n}\n\nlet doorSeconds = doorSince ? Math.floor((Date.now() - doorSince) / 1000) : 0;\nlet status = \"Safe\";\nlet fan = false;\nlet critical = false;\nlet reason = \"Temperature is in the normal 2.0-8.0C range.\";\n\nif (temp > 12 || doorSeconds > 30) {\n    status = \"Critical\";\n    critical = true;\n    fan = true;\n    if (temp > 12 && doorSeconds > 30) {\n        reason = \"Temperature is above 12C and the door has been open for more than 30 seconds.\";\n    } else if (temp > 12) {\n        reason = \"Temperature is above 12C.\";\n    } else {\n        reason = \"Door has been open for more than 30 seconds.\";\n    }\n} else if (temp > 8) {\n    status = \"Warning\";\n    fan = true;\n    reason = \"Temperature is above 8C, so the auxiliary cooling fan is ON.\";\n} else if (temp < 2) {\n    // below the normal band - not part of the original spec's warning/critical\n    // tiers, but flagged separately so it isn't silently reported as \"Safe\"\n    status = \"Low\";\n    reason = \"Temperature is below the normal 2.0C floor.\";\n}\n\nmsg.payload = {\n    unit_id: data.unit_id || \"FRIDGE-01\",\n    temp: temp,\n    door_open: doorOpen,\n    door_open_seconds: doorSeconds,\n    status: status,\n    fan: fan,\n    critical: critical,\n    reason: reason\n};\n\nlet statusMsg = {payload: status};\nlet fanMsg = {payload: fan ? \"FAN ON\" : \"FAN OFF\"};\nlet alarmMsg = {\n    payload: critical ? \"ALARM: \" + reason : \"No critical alarm\"\n};\nlet alertMsg = {\n    payload: {\n        unit_id: msg.payload.unit_id,\n        temperature: temp,\n        door_open: doorOpen,\n        door_open_seconds: doorSeconds,\n        status: status,\n        message: reason\n    }\n};\n\nif (critical) {\n    return [statusMsg, fanMsg, alarmMsg, alertMsg];\n}\n\nreturn [statusMsg, fanMsg, alarmMsg, null];\n",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 280,
        "wires": [
            [
                "ui_status"
            ],
            [
                "dbg_fan"
            ],
            [
                "ui_alarm"
            ],
            [
                "link_to_alert"
            ]
        ]
    },
