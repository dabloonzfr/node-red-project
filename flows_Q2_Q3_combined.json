    {
        "id": "fn_q3",
        "type": "function",
        "z": "tab_q3",
        "name": "Prepare Dashboard Data",
        "func": "let data = msg.payload;\nif (typeof data === \"string\") {\n    try { data = JSON.parse(data); }\n    catch (e) { node.error(\"Invalid sensor JSON\", msg); return null; }\n}\n\nlet temp = Number(data.temp);\nlet humidity = Number(data.humidity);\n\nif (Number.isNaN(temp) || Number.isNaN(humidity)) {\n    node.error(\"Temperature or humidity is missing/invalid\", msg);\n    return null;\n}\n\nlet status = \"NORMAL\";\nlet color = \"green\";\n\nif (temp > 12 || data.door_open === true) {\n    status = \"ALARM\";\n    color = \"red\";\n} else if (temp > 8) {\n    status = \"WARNING\";\n    color = \"orange\";\n}\n\nlet tempMsg = {payload: temp};\nlet humidityMsg = {payload: humidity};\nlet statusMsg = {payload: {status: status, color: color}};\nlet chartMsg = {payload: temp};\n\nreturn [tempMsg, humidityMsg, statusMsg, chartMsg];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
